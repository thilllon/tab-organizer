---
import { Image } from 'astro:assets';

import afterSort from '../../../../screenshots/after-sort.png';
import beforeSort from '../../../../screenshots/before-sort.png';
import shotHistory from '../../../../screenshots/dashboard-history.png';
import shotRestore from '../../../../screenshots/dashboard-restore.png';
import shotSearch from '../../../../screenshots/dashboard-search.png';
import shotSessions from '../../../../screenshots/dashboard-sessions.png';
import shotSettings from '../../../../screenshots/screenshot-1280x800.png';
import AddToChrome from '../../components/add-to-chrome.astro';
import Icon from '../../components/icon.astro';
import { localePaths, pageUrl, type Locale } from '../../i18n/locales';
import { copyFor, type FeatureShot } from '../../i18n/site-copy';
import BaseLayout from '../../layouts/base-layout.astro';

export function getStaticPaths() {
  return localePaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = copyFor(locale);

const SHOTS: Record<FeatureShot, ImageMetadata> = {
  restore: shotRestore,
  history: shotHistory,
  search: shotSearch,
  settings: shotSettings,
};

/**
 * Shots that are cropped in CSS to the part their row talks about: the search results without
 * the empty half below them, the Settings dialog without the dimmed page around it. A cropped
 * shot is drawn larger than its frame, so it asks for a wider image.
 */
const CROPS: Partial<Record<FeatureShot, { className: string; sizes: string }>> = {
  search: { className: 'crop-search', sizes: '(min-width: 60rem) 48rem, calc(130vw - 3.25rem)' },
  settings: { className: 'crop-settings', sizes: '(min-width: 60rem) 60rem, calc(160vw - 4rem)' },
};

const PROMISE_ICONS = ['device', 'user-off', 'wifi-off'] as const;
const SHOT_SIZES = '(min-width: 60rem) 36rem, calc(100vw - 2.5rem)';
---

<BaseLayout
  locale={locale}
  page="home"
  title={copy.meta.homeTitle}
  description={copy.meta.homeDescription}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">
        <Icon name="puzzle" size={16} />
        {copy.hero.eyebrow}
      </p>
      <h1 class="hero-title">{copy.hero.title}</h1>
      <p class="hero-lead">{copy.hero.lead}</p>
      <div class="hero-actions">
        <AddToChrome label={copy.cta.addToChrome} />
        <a class="button button-secondary" href="#features">{copy.cta.seeFeatures}</a>
      </div>
      <p class="hero-note">{copy.cta.note}</p>
    </div>
    <div class="container hero-shot">
      <figure class="shot">
        <div class="shot-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <Image
          src={shotSessions}
          alt={copy.hero.imageAlt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 72rem) 64rem, calc(100vw - 2.5rem)"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-head centered">
        <span class="kicker">{copy.sort.kicker}</span>
        <h2 class="section-title">{copy.sort.title}</h2>
        <p class="section-lead">{copy.sort.lead}</p>
      </div>
      <div class="strips">
        <figure class="strip">
          <figcaption>{copy.sort.before}</figcaption>
          <div class="strip-frame">
            <Image
              src={beforeSort}
              alt={copy.sort.beforeAlt}
              widths={[960, 1280]}
              sizes="(min-width: 72rem) 64rem, calc(100vw - 2.5rem)"
            />
          </div>
        </figure>
        <figure class="strip">
          <figcaption>{copy.sort.after}</figcaption>
          <div class="strip-frame">
            <Image
              src={afterSort}
              alt={copy.sort.afterAlt}
              widths={[960, 1280]}
              sizes="(min-width: 72rem) 64rem, calc(100vw - 2.5rem)"
            />
          </div>
        </figure>
      </div>
      <ul class="checks sort-points">
        {copy.sort.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  {
    copy.rows.map((row, index) => (
      <section class:list={['section', 'feature-row', { 'section-muted': index % 2 === 0 }]}>
        <div class:list={['container', 'row-inner', { flipped: index % 2 === 1 }]}>
          <div class="row-text">
            <span class="kicker">{row.kicker}</span>
            <h2 class="section-title">{row.title}</h2>
            <p class="section-lead">{row.body}</p>
            <ul class="checks">
              {row.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
          <figure class="shot row-shot">
            <div class="shot-bar" aria-hidden="true">
              <span />
              <span />
              <span />
            </div>
            <div class:list={['row-shot-crop', CROPS[row.shot]?.className]}>
              <Image
                src={SHOTS[row.shot]}
                alt={row.alt}
                widths={[640, 960, 1280]}
                sizes={CROPS[row.shot]?.sizes ?? SHOT_SIZES}
              />
            </div>
          </figure>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container">
      <div class="section-head centered">
        <h2 class="section-title">{copy.more.title}</h2>
        <p class="section-lead">{copy.more.lead}</p>
      </div>
      <ul class="cards">
        {
          copy.more.cards.map((card) => (
            <li class="card">
              <span class="card-icon">
                <Icon name={card.icon} size={22} />
              </span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-muted promise">
    <div class="container">
      <div class="section-head centered">
        <h2 class="section-title">{copy.promise.title}</h2>
        <p class="section-lead">{copy.promise.lead}</p>
      </div>
      <ul class="promise-points">
        {
          copy.promise.points.map((point, index) => (
            <li>
              <span class="card-icon">
                <Icon name={PROMISE_ICONS[index] ?? 'device'} size={22} />
              </span>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="promise-link">
        <a href={pageUrl(locale, 'privacy')}>
          {copy.promise.link}
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <section class="section closing">
    <div class="container closing-inner">
      <h2 class="section-title">{copy.closing.title}</h2>
      <p class="section-lead">{copy.closing.lead}</p>
      <div class="hero-actions">
        <AddToChrome label={copy.cta.addToChrome} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 4.5rem;
    overflow: hidden;
    background:
      radial-gradient(
        60rem 28rem at 50% -6rem,
        color-mix(in oklch, var(--primary) 14%, transparent),
        transparent 70%
      ),
      var(--background);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .hero-title {
    margin-top: 1.25rem;
    max-width: 48rem;
    font-size: clamp(2.125rem, 1.4rem + 3.4vw, 3.75rem);
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  :global(html:lang(ko)) .hero-title,
  :global(html:lang(ja)) .hero-title {
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .hero-lead {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    color: var(--muted-foreground);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .hero-shot {
    margin-top: 3.5rem;
    max-width: calc(64rem + 2 * var(--gutter));
  }

  .hero-shot .shot {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: 0;
  }

  .strips {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    max-width: 64rem;
    margin-inline: auto;
  }

  .strip {
    margin: 0;
  }

  .strip figcaption {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted-foreground);
  }

  /*
   * The before/after captures are whole 1280 x 800 windows; only the tab row matters. The window's
   * own title bar (the top 31px) is cropped away, since the figcaption already says Before/After:
   * the frame shows rows 31 to 71, and 31 / (800 - 40) is the object-position below.
   */
  .strip-frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: #202124;
  }

  .strip-frame :global(img) {
    width: 100%;
    aspect-ratio: 1280 / 40;
    object-fit: cover;
    object-position: left 4.08%;
  }

  /* On a phone the strip stays legible and scrolls sideways inside its frame, not the page. */
  @media (max-width: 48rem) {
    .strip-frame {
      overflow-x: auto;
    }

    .strip-frame :global(img) {
      width: 56rem;
      max-width: none;
    }
  }

  .sort-points {
    max-width: 64rem;
    margin: 2rem auto 0;
  }

  @media (min-width: 48rem) {
    .sort-points {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .row-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .row-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }

    /* The screenshot keeps the wide column on flipped rows too. */
    .row-inner.flipped {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .row-inner.flipped .row-text {
      order: 2;
    }
  }

  .row-shot-crop {
    overflow: hidden;
  }

  /* Search: the top 560 of 800 rows, where the results are. */
  .crop-search :global(img) {
    aspect-ratio: 1280 / 560;
    object-fit: cover;
    object-position: top;
  }

  /*
   * Settings: the dialog (x 240 to 1040, y 20 to 780 of 1280 x 800), drawn at 160% so it fills
   * the frame. Margins in % are of the frame's width: 240 / 800 and 20 / 800.
   */
  .crop-settings {
    aspect-ratio: 800 / 760;
  }

  .crop-settings :global(img) {
    width: 160%;
    max-width: none;
    margin-left: -30%;
    margin-top: -2.5%;
  }

  .cards,
  .promise-points {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .promise-points {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .card,
  .promise-points li {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }

  .card h3,
  .promise-points h3 {
    margin-top: 1rem;
    font-size: 1.0625rem;
    font-weight: 650;
  }

  .card p,
  .promise-points p {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .promise-link {
    margin-top: 2rem;
    text-align: center;
  }

  .promise-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .promise-link a:hover {
    text-decoration: underline;
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .closing .section-lead {
    margin-inline: auto;
  }
</style>
