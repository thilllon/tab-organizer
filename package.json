{
  "name": "tab-organizer",
  "displayName": "Tab Organizer",
  "description": "Sort and group every tab in one click, then save and restore whole windows as sessions. Offline, no account, stays on your device.",
  "version": "7.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/tab-organizer.git"
  },
  "keywords": [
    "chrome-extension",
    "tab-organizer",
    "tab-sort"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write . && prettier --write '**/*.{md,mdx,yml,yaml}' && mise format",
    "listing": "tsx ./scripts/build-listing.ts",
    "store:bundle": "tsx ./scripts/store-bundle.ts",
    "test": "vitest run",
    "e2e:smoke": "tsx scripts/e2e/smoke.ts",
    "e2e:sort": "tsx scripts/e2e/sort.ts",
    "e2e:assemble": "vite build --mode e2e --outDir dist-e2e && tsx scripts/e2e/assemble.ts",
    "release": "release-it"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "prettier": "^3.9.9",
    "release-it": "^21.1.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
