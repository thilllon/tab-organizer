{
  "name": "tab-organizer",
  "displayName": "Tab Organizer",
  "version": "7.13.3",
  "description": "Sort and group every tab in one click, then save and restore whole windows as sessions. Offline, no account, stays on your device.",
  "keywords": [
    "chrome-extension",
    "tab-organizer",
    "tab-sort"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/tab-organizer.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings && tsx scripts/check-dashes.ts",
    "lint:fix": "oxlint --fix --deny-warnings",
    "store:bundle": "tsx ./scripts/store-bundle.ts",
    "test": "vitest run",
    "e2e:smoke": "tsx scripts/e2e/smoke.ts",
    "e2e:sort": "tsx scripts/e2e/sort.ts",
    "e2e:selection": "tsx scripts/e2e/selection.ts",
    "e2e:assemble": "vite build --mode e2e --outDir node_modules/.cache/tab-organizer/e2e && tsx scripts/e2e/assemble.ts",
    "release": "release-it",
    "check:dashes": "tsx scripts/check-dashes.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "release-it": "^21.1.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
